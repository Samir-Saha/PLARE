# Postgres in production (Supabase connection string), SQLite locally.
DATABASE_URL=sqlite:///./plare.db
# Supabase Auth. URL is enough for projects with asymmetric JWT signing keys;
# set the JWT secret only for legacy HS256 projects.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Demo sign-in with seeded fictional accounts. Local/demo only, never in production.
DEMO_AUTH=true
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
# Send GM reminders from a once-a-minute loop inside the API process.
RUN_REMINDERS=true
# Free Hugging Face token (huggingface.co > Settings > Access Tokens, "Read" is enough).
# Blank turns the AI-writing check off.
HF_TOKEN=
# Optional: a different detector model on Hugging Face's hf-inference provider.
# HF_AI_DETECTOR_MODEL=Hello-SimpleAI/chatgpt-detector-roberta
